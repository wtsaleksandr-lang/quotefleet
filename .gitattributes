# Normalize line endings to LF on checkin; let git decide on checkout.
* text=auto eol=lf

# Binary types — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary

# Lockfiles — keep as-is, mark as generated for diff folding.
pnpm-lock.yaml linguist-generated=true -diff

# TIGER-NET routing assets. Public-domain US Census data, regenerated by
# scripts/tiger-net/build.mjs. Marked binary so git never tries to diff, merge
# or normalise 4.5 MB of packed coordinates — a line-ending "fix" on these
# would silently corrupt every mile the quote tool measures.
assets/tiger/*.gz binary -diff -merge linguist-generated
assets/tiger/*.zip binary -diff -merge
