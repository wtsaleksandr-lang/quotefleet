# ──────────────────────────────────────────────────────────────────────────
# QuoteFleet — environment configuration
# Copy to .env and fill in the values. On Replit set these as Secrets.
# ──────────────────────────────────────────────────────────────────────────

# REQUIRED — Postgres connection string (Neon recommended, free tier).
# Format: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/quotefleet?sslmode=require

# REQUIRED — Anthropic API key. Used by the AI agent for rate adjustment,
# auto-reply emails, and customer-service chat. Each tenant can also set
# their own key from the dashboard (overrides this default).
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional — public base URL of the deployment. Used to generate embed
# snippets that customers paste on their website. Set to your Replit
# deployment URL or custom domain.
PUBLIC_BASE_URL=https://quotefleet.net

# Optional — comma-separated list of platform-owned domains. Each tenant
# gets a subdomain `<slug>.<domain>` on whichever they pick at signup.
# Wildcard DNS for each (`*.<domain>`) must point at this deployment.
# The first entry is the default. See docs/multi-host-setup.md.
HOST_DOMAINS=quotefleet.net,truckrate.online,your-quote.online

# Optional — secret used to sign session cookies. If not set, a random
# 32-byte value is generated on first start (bad for prod — set explicitly).
SESSION_SECRET=replace-with-random-32-byte-hex-string

# Optional — port to bind to. Replit's default web port is 5000.
PORT=5000

# Optional — bind host. 0.0.0.0 lets Replit's proxy reach the server.
HOST=0.0.0.0

# Optional — bootstrap super-admin email. The first user that signs up
# with this email is granted super-admin (across-all-tenant) access.
# Useful so you don't have to fiddle with the DB on first deploy.
SUPER_ADMIN_EMAIL=you@yourdomain.com

# Optional — Google Maps API key (Places + Geocoding APIs enabled).
# Drives address autocomplete (USA/Canada only). Reuse a key from another
# project if you have one — restrict it by domain to keep it safe.
GOOGLE_MAPS_API_KEY=

# Optional — Mapbox token, fallback for autocomplete + geocoding.
# Used only if GOOGLE_MAPS_API_KEY is unset.
MAPBOX_TOKEN=

# Optional — SMTP for outgoing email (lead notifications, auto-reply
# to customers, magic-link login). When unset, emails are logged to
# stdout instead of sent (fine for dev / first weeks of pilot).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QuoteFleet <noreply@quotefleet.com>"

# Optional — EIA (US Energy Info Admin) API key for live diesel-price
# index used in the fuel-surcharge formula. Free key from
# https://www.eia.gov/opendata/. Falls back to a hardcoded recent
# value when unset.
EIA_API_KEY=

# REQUIRED IN PRODUCTION — shared secret between the Cloudflare Worker that
# fronts wildcard subdomains and this app. The Worker sets `X-Worker-Auth`;
# hostInfo refuses to trust `X-Original-Host` unless it matches. If unset,
# the app falls back to trusting the header from any source (logs a warning)
# — do not run prod without this. Generate with `openssl rand -hex 32`.
WORKER_AUTH_SECRET=

# ── Billing (Stripe) — optional, feature-gated ──────────────────────────────
# Unset = billing/upgrade flow disabled. Set all of these to enable paid plans.
# Secret + publishable keys from the Stripe dashboard.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook signing secret (whsec_...) for the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price IDs (price_...) for each paid plan tier.
STRIPE_PRICE_VITAL_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# ── Transactional email (Resend) — optional ─────────────────────────────────
# Alternative to SMTP for outgoing email. If set, used in preference to SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL="QuoteFleet <noreply@quotefleet.net>"

# ── Forward-email auto-import (rate emails) — optional, feature-gated ────────
# Carriers can forward/BCC their rate emails to a dedicated per-tenant address
# and the system reads + updates their calculator automatically (per-tenant
# toggle, default OFF). Two things must be set for it to go live:
#
#  1. INBOUND_EMAIL_DOMAIN — the domain the per-tenant inbound addresses live
#     under. Each tenant gets `rates-<token>@<this-domain>`. You must point this
#     domain's MX records at your mail provider's inbound service and route the
#     parsed webhook at POST /api/inbound/rate-email (see handoff notes below).
#     Unset → the dashboard shows a placeholder and no live address.
INBOUND_EMAIL_DOMAIN=rates.quotefleet.net
#  2. INBOUND_WEBHOOK_SECRET — shared secret the provider sends as the
#     `X-Inbound-Secret` header on every inbound POST. The endpoint rejects any
#     request whose header doesn't match (and refuses ALL requests when unset).
#     Generate with `openssl rand -hex 32`.
INBOUND_WEBHOOK_SECRET=

# ── Cold-outreach (Smartlead) — optional, feature-gated ─────────────────────
# Outreach sending is disabled unless both API key + sending domain are set.
SMARTLEAD_API_KEY=
SMARTLEAD_SENDING_DOMAIN=
# Optional API base override; defaults to https://server.smartlead.ai/api/v1.
SMARTLEAD_BASE_URL=

# Optional — FMCSA QCMobile API "WebKey" for the super-admin outreach
# company-enrichment tool. When set, enrichment adds MC/DOT + firmographics
# (fleet size, entity type). When unset, that lookup soft-skips; the rest of
# the profile is unaffected. Free key: register at
# https://mobile.fmcsa.dot.gov/QCDevsite/docs/getStarted
FMCSA_WEBKEY=

# Optional — Sentry DSN. When set, errors are reported here. Off by default
# to keep the dev loop cheap.
SENTRY_DSN=

# Optional — soft global daily spend cap (USD) on the platform Anthropic key.
# When exceeded, marketing chat + AI endpoints short-circuit with a 503.
AI_DAILY_USD_CAP=

# DANGER — set to 1/true ONLY for local debugging or test runners. Disables
# ALL trial/plan gating (hands out free unlimited access). NEVER enable in
# production; the app logs a loud security warning at boot if it detects this.
BYPASS_TRIAL_ENFORCEMENT=

# ── HARD COST GUARD for paid external providers (ImportYeti / Hunter) ────────
# DEFAULT DENY. Importer Search's providers are metered, real-money APIs; ~$20
# of credits were burned in two days largely by dev / test / agent traffic. The
# choke point in src/server/directory/externalPullGuard.ts refuses EVERY live
# pull unless one of these flags explicitly opts in — an unconfigured process
# opens no socket and serves the licensed cache only.
#
# NODE_ENV is deliberately NOT consulted: QuoteFleet's Doppler `dev` config sets
# NODE_ENV=production (and the same PUBLIC_BASE_URL as prod), so a laptop boot
# is indistinguishable from production by environment sniffing.
#
# Set EXTERNAL_PULLS_ENABLED=1 in the PRODUCTION config ONLY. Leave it unset
# everywhere else. Setting any flag to 0 force-disables that provider even in
# production (the incident kill switch).
EXTERNAL_PULLS_ENABLED=
IMPORTYETI_LIVE_PULLS=
HUNTER_LIVE=
PROSPEO_LIVE=
APOLLO_LIVE=
IMPORTER_DRAFTS_LIVE=

# ── CONTACT-ENRICHMENT PROVIDER CHAIN (the Leads Pro reveal) ────────────────
# The reveal resolves a decision-maker email through a CHAIN of providers, not
# one: it tries them in order and stops at the first that answers, so a single
# provider's exhausted free tier no longer caps how many reveals can be sold.
#
#   PROSPEO_API_KEY   Prospeo — 100 free credits/month. ~2 credits per reveal
#                     (one domain search + one email reveal) → ~50 reveals.
#                     Needs a DOMAIN, which ImportYeti's company_website usually
#                     supplies for free.
#   HUNTER_API_KEY    Hunter — ~25 free searches/month, but the only provider
#                     that can resolve a company NAME with no known domain, so
#                     it is the fallback rather than the workhorse.
#
# Comma-separated, cheapest-usable-quota first. Unknown names are ignored and an
# empty/invalid value falls back to the built-in default, so a typo degrades to
# a working chain instead of taking the reveal down. Naming a subset is how you
# park a provider without removing its key.
PROSPEO_API_KEY=
ENRICHMENT_PROVIDER_ORDER=prospeo,hunter

# APOLLO_API_KEY is NOT read by the chain. Apollo's People Search answers
# HTTP 403 API_INACCESSIBLE on the Free plan — "not accessible, even with a
# master key" — so there is no free path to a work email there. The guard flag
# above exists so the provider can be switched on the day the plan is upgraded.

# ── Manifest Privacy — the Agent named on the Limited Power of Attorney ──────
#
# The POA is an executed legal instrument, and 19 CFR 141.32's model form names
# the agent AND its address. Those are FACTS about the business, so they are
# configuration and never a hardcoded guess: an unverified address on a signed
# POA is a false statement and fails on any CBP look-through.
#
#   MANIFEST_AGENT_LEGAL_NAME  Defaults to "QuoteFleet, Inc.".
#   MANIFEST_AGENT_ADDRESS     The physical notice address. While it is UNSET the
#                              POA names the Agent by its email notice address
#                              (legal@quotefleet.net) and the admin pre-filing
#                              gate BLOCKS the filing with an "Agent's own filing
#                              address configured" check — so this shows up as a
#                              config task, not a silently wrong document.
MANIFEST_AGENT_LEGAL_NAME=
MANIFEST_AGENT_ADDRESS=
